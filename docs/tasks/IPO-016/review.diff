+    snapshot = first.json()
+    assert set(snapshot) == {
+        "session_id",
+        "act_number",
+        "status",
+        "started_at",
+        "balance",
+        "clients",
+        "action_points",
+        "hiring_level",
+        "hiring_capacity",
+        "hired_development_team_grades",
+        "experiments_per_development_team",
+        "starting_bonus",
+    }
